# Copy to secrets/.env.local. Never commit the filled-in file.

# Public URL of the control server, at most 64 bytes. Patched into agent binaries.
ZEDR_SERVER_URL=https://control.example.test:7770

# Developer-managed test VMs, see docs/development/VM_SETUP.md
ZEDR_VM_USER=
ZEDR_VM_PASSWORD=
ZEDR_VM_LINUX_PORT=
ZEDR_VM_WINDOWS_PORT=
ZEDR_VM_MACOS_PORT=
ZEDR_VM_MACOS_IP=

# Where the Vite dev server proxies API calls
VITE_API_URL=https://localhost:7770
