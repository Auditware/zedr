# Copy to secrets/.env.server.local. Never commit the filled-in file.

ZEDR_SERVER_HOST=127.0.0.1
ZEDR_SERVER_PORT=7770
ZEDR_SERVER_URL=https://control.example.test:7770
ZEDR_CORS_ORIGIN=https://localhost:7771
DATABASE_URL=sqlite://zedr.db?mode=rwc
ZEDR_AGENT_VERSION=0.1.0

# Secrets. Generate each one, never reuse the values of another environment.
# JWT_SECRET: openssl rand -hex 32
# ZEDR_SIGNING_KEY_HEX: openssl rand -hex 32 (back it up, the server patches its public key into every agent it serves and those agents trust only this key)
JWT_SECRET=
ADMIN_PASSWORD=
ZEDR_SIGNING_KEY_HEX=

# PEM files the server presents to agents and browsers, and the agent binaries it serves.
# `make dev` supplies these through control_server/ecosystem.config.js.
ZEDR_TLS_CERT_PATH=
ZEDR_TLS_KEY_PATH=
ZEDR_BINARIES_DIR=

# Optional. Comma-separated CIDRs allowed to reach the console and admin API. Empty means unrestricted.
ZEDR_ADMIN_ALLOWED_CIDRS=
# Optional. Public key of a replaced signing key, from the refusal the server prints at startup. Enrolled agents must be reinstalled.
ZEDR_SIGNING_KEY_CHANGE_ACCEPTED=
# Optional. Directory of the built console, served by the control server itself.
ZEDR_FRONTEND_DIST=
