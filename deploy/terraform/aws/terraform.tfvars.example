# Copy to terraform.tfvars and fill in. Keep terraform.tfvars out of git.

region = "eu-central-1"

# Where SSH and the Kubernetes API may be reached from: your office or VPN egress.
admin_cidr = ["203.0.113.10/32"]

# The one line of your public key file, for example ~/.ssh/id_ed25519.pub.
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# instance_type  = "t4g.medium"
# root_volume_gb = 50
